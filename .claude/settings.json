{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.sandbox)",
      "Read(**/.env.prod)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/service-account*.json)",
      "Read(**/credentials.json)",
      "Read(**/client_secret*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*.local)",
      "Edit(**/project.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.git/hooks/**)",
      "Bash(sudo:*)",
      "Bash(printenv:*)",
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",
      "Bash(suitecloud account:setup:*)",
      "Bash(suitecloud account:manageauth:*)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(gcloud iam service-accounts keys create:*)",
      "Bash(vercel env pull:*)"
    ],
    "ask": [
      "Bash(suitecloud project:deploy:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(gcloud:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(rm:*)",
      "WebFetch"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/zero-trust-guard.js\""
          }
        ]
      }
    ]
  }
}
